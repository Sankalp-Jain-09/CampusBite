# Copy to .env and fill in real values:  cp .env.example .env
# .env is used by docker compose (variable substitution + backend env_file). Never commit .env.

# ---- Database (PostgreSQL container) ----
POSTGRES_USER=campusbite
POSTGRES_PASSWORD=change_me
POSTGRES_DB=campusbite
POSTGRES_PORT=5432
# Note: docker-compose.yml builds DATABASE_URL for the backend from the values above.

# ---- Backend ----
BACKEND_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
SEED_DEMO_DATA=true

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_PER_MINUTE=10

# ---- Reminders ----
REMINDER_THRESHOLD_MINUTES=15
REMINDER_CHECK_INTERVAL_SECONDS=60

# ---- Orders ----
CANCEL_GRACE_SECONDS=60
DELIVERY_FEE=30
