# For running the backend WITHOUT Docker (e.g. `uvicorn app.main:app --reload` from backend/).
# Copy to backend/.env and fill in real values. Never commit .env.
# When using Docker Compose, use the root .env.example instead.

DATABASE_URL=postgresql+psycopg://campusbite:change_me@localhost:5432/campusbite

LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
SEED_DEMO_DATA=false

JWT_SECRET_KEY=replace_with_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_PER_MINUTE=10

REMINDER_THRESHOLD_MINUTES=15
REMINDER_CHECK_INTERVAL_SECONDS=60

CANCEL_GRACE_SECONDS=60
DELIVERY_FEE=30
